{% doc %}
  Figma Brand Grid (14:1663): six columns at fixed percentages of the width plus
  baseline rows ("Fine" = 30px, "Medium" = 60px). Ink over bone, bone over imagery.
  Drawn entirely with backgrounds on one element; position the host relative, the
  grid fills it.

  @param {string} [tone] - 'ink' (default) or 'bone'
  @param {number} [rows] - Row spacing in px (rows start one spacing down); 0 for columns only. Default 30.
  @param {string} [columns] - Which of the six columns to draw, e.g. '1,3,4'. Default all.
  @param {string} [class] - Extra class, e.g. to hide it on mobile
  @param {string} [style] - Extra inline style, e.g. to lay the grid over a wider area than its host

  @example
  {% render 'oot-brand-grid', tone: 'bone', rows: 0, columns: '1,3,4' %}
{% enddoc %}

{%- liquid
  assign row_spacing = rows | default: 30
  assign grid_style = '--oot-grid-row: ' | append: row_spacing | append: 'px;'
  if rows == 0
    assign grid_style = grid_style | append: '--oot-grid-line: transparent;'
  endif
  if columns != blank
    assign shown = columns | split: ','
    for n in (1..6)
      assign n_string = n | append: ''
      unless shown contains n_string
        assign grid_style = grid_style | append: '--oot-grid-col-' | append: n | append: ': transparent;'
      endunless
    endfor
  endif
-%}

<div
  class="oot-brand-grid oot-brand-grid--{{ tone | default: 'ink' }} {{ class }}"
  style="{{ grid_style }}{{ style }}"
  aria-hidden="true"
></div>

{% stylesheet %}
  .oot-brand-grid {
    position: absolute;
    inset: 0;
    pointer-events: none;
    /* Six 1px columns, then baseline rows starting one row down. A percentage
       position on a 1px image lands within a pixel of the Figma column. Each column
       can be hidden by setting its --oot-grid-col-N to transparent. */
    background-image:
      linear-gradient(var(--oot-grid-col-1, var(--oot-grid-col)), var(--oot-grid-col-1, var(--oot-grid-col))),
      linear-gradient(var(--oot-grid-col-2, var(--oot-grid-col)), var(--oot-grid-col-2, var(--oot-grid-col))),
      linear-gradient(var(--oot-grid-col-3, var(--oot-grid-col)), var(--oot-grid-col-3, var(--oot-grid-col))),
      linear-gradient(var(--oot-grid-col-4, var(--oot-grid-col)), var(--oot-grid-col-4, var(--oot-grid-col))),
      linear-gradient(var(--oot-grid-col-5, var(--oot-grid-col)), var(--oot-grid-col-5, var(--oot-grid-col))),
      linear-gradient(var(--oot-grid-col-6, var(--oot-grid-col)), var(--oot-grid-col-6, var(--oot-grid-col))),
      linear-gradient(to bottom, transparent calc(var(--oot-grid-row) - 1px), var(--oot-grid-line) 0);
    background-size:
      1px 100%, 1px 100%, 1px 100%, 1px 100%, 1px 100%, 1px 100%,
      100% var(--oot-grid-row);
    background-position: 10.94% 0, 26.56% 0, 42.19% 0, 57.81% 0, 73.44% 0, 89.06% 0, 0 0;
    background-repeat: no-repeat, no-repeat, no-repeat, no-repeat, no-repeat, no-repeat, repeat-y;
  }

  .oot-brand-grid--ink {
    --oot-grid-line: rgb(56 51 49 / 0.08);
    --oot-grid-col: rgb(56 51 49 / 0.14);
  }

  .oot-brand-grid--bone {
    --oot-grid-line: rgb(242 237 230 / 0.12);
    --oot-grid-col: rgb(242 237 230 / 0.24);
  }
{% endstylesheet %}
