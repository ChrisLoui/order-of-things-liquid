{% doc %}
  A photo filling its positioned host with object-fit: cover. The source is the first
  that exists: product media, the merchant's image_picker choice, then a photo bundled
  with the theme in assets/.

  The first photo appears in both the desktop grid and the mobile carousel, and CSS
  hides one. Pass hidden_on so that copy's <picture> serves a blank pixel at the other
  breakpoint: each device then downloads only the image it shows.

  @param {object} [media] - Product media, used first
  @param {image} [image] - An image_picker value
  @param {string} fallback - Bundled asset filename, e.g. 'oot-gallery-1.jpg'
  @param {string} alt - Alt text when the image has none (the caption)
  @param {string} sizes - The sizes attribute for this layout slot
  @param {boolean} [priority] - The LCP image: eager, high fetch priority
  @param {string} [hidden_on] - 'mobile' or 'desktop': where CSS hides this copy
  @param {string} [class] - Extra class on the <img>

  @example
  {% render 'oot-image', image: block.settings.image, fallback: 'oot-gallery-1.jpg', alt: 'Studio front', sizes: '100vw', priority: true, hidden_on: 'desktop' %}
{% enddoc %}

{%- liquid
  assign source = image
  if media
    assign source = media.preview_image
  endif

  assign image_class = 'oot-image ' | append: class | strip

  assign loading = 'lazy'
  assign fetchpriority = 'auto'
  if priority
    assign loading = 'eager'
    assign fetchpriority = 'high'
  endif
-%}

{%- capture img -%}
  {%- if source -%}
    {%- assign alt_text = source.alt | default: alt -%}
    {{
      source
      | image_url: width: 1600
      | image_tag:
        widths: '400, 600, 800, 1200, 1600',
        sizes: sizes,
        loading: loading,
        fetchpriority: fetchpriority,
        alt: alt_text,
        class: image_class
    }}
  {%- else -%}
    {%- # Bundled photos are already web-sized (1200–2400px), so one size serves every slot. -%}
    <img
      src="{{ fallback | asset_url }}"
      alt="{{ alt | escape }}"
      width="1200"
      height="1600"
      loading="{{ loading }}"
      fetchpriority="{{ fetchpriority }}"
      class="{{ image_class }}"
    >
  {%- endif -%}
{%- endcapture -%}

{%- if hidden_on != blank -%}
  <picture>
    <source
      media="{% if hidden_on == 'desktop' %}(min-width: 1024px){% else %}(max-width: 1023.98px){% endif %}"
      srcset="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw=="
    >
    {{ img }}
  </picture>
{%- else -%}
  {{ img }}
{%- endif -%}

{% stylesheet %}
  .oot-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
{% endstylesheet %}
