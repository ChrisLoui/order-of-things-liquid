{% doc %}
  Renders an Order of Things icon as inline SVG in currentColor, so it follows the
  surrounding text color. Icons are decorative (aria-hidden); name the control instead.

  @param {string} name - Filled: wordmark, logo-symbol, menu, arrow. Line (24px, 1.5px
    stroke, Figma figma-assets/manual/icons): search, truck, return, origin, spray, neck,
    wrist, no-rub, drop, ribbon, flask, carton, gift, clock
  @param {string} [class] - Extra class for sizing

  @example
  {% render 'oot-icon', name: 'search', class: 'oot-header__search-icon' %}
{% enddoc %}

